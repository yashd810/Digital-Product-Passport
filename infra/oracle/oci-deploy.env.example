# Copy this file to the private environment folder outside the repository as
# `oci-deploy.env`, then chmod it to 600. The deployment wrapper reads only
# these literal key/value pairs; it never sources the file as shell code.
OCI_BACKEND_IP=<backend-host-ip>
OCI_FRONTEND_IP=<frontend-host-ip>
# Dedicated restricted SSH deployment account. It must not be in the Docker
# group and may have sudo access only to /usr/local/sbin/dpp-release-deployer.
OCI_USER=dpp-release
# Use one controller key per split host. The wrapper selects the matching key
# and will not use one target's key for the other host.
OCI_BACKEND_SSH_KEY=/absolute/path/to/backend-oci-deployment.key
OCI_FRONTEND_SSH_KEY=/absolute/path/to/frontend-oci-deployment.key
# SSH_KEY is only for an intentionally single-host deployment where one
# restricted controller key is authorized for that one host.
# SSH_KEY=/absolute/path/to/oci-deployment.key
SSH_KNOWN_HOSTS=/absolute/path/to/trusted-known_hosts
